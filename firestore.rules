rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function isSuperAdmin() {
      return isAuth() && request.auth.token.email == 'sedomem@gmail.com';
    }

    function isGroupAdmin() {
      return isAuth() && getUserData().role == 'groupadmin';
    }

    function isSuperOrGroup() { return isSuperAdmin() || isGroupAdmin(); }

    match /users/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && uid() == userId;
      allow update: if (isAuth() && uid() == userId) || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /clubs/{id} {
      allow read: if true;
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || (isGroupAdmin() && resource.data.adminUid == uid());
      allow delete: if isSuperAdmin();
    }

    match /events/{id} {
      allow read: if true;
      allow create: if isSuperOrGroup();
      allow update: if isSuperAdmin() || (isGroupAdmin() && (resource.data.adminUid == uid() || resource.data.clubId == getUserData().clubId));
      allow delete: if isSuperAdmin();
    }

    match /races/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /blog/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /blog_comments/{id} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() && uid() == resource.data.userUid;
      allow delete: if isSuperAdmin() || (isAuth() && uid() == resource.data.userUid);
    }

    match /popup/{id} { allow read: if true; allow write: if isSuperAdmin(); }
    match /banners/{id} { allow read: if true; allow write: if isSuperAdmin(); }
    match /sponsors/{id} { allow read: if true; allow write: if isSuperAdmin(); }
    match /firsatlar/{id} { allow read: if true; allow write: if isSuperAdmin(); }
    match /ticker/{id} { allow read: if true; allow write: if isSuperAdmin(); }

    match /rsvps/{id} {
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAuth() && uid() == resource.data.uid;
    }

    match /memberships/{id} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isSuperOrGroup() || (isAuth() && (resource.data.uid == uid() || resource.data.userId == uid()));
    }

    match /contactMessages/{id} {
      allow read: if isSuperAdmin();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /applications/{id} {
      allow read: if isSuperOrGroup();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /chats/{room}/{document=**} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isSuperAdmin();
    }

    match /newsletter/{id} {
      allow read: if isSuperAdmin();
      allow create: if true;
      allow delete: if isSuperAdmin();
    }

    match /announcements/{id} {
      allow read: if isAuth();
      allow create: if isSuperOrGroup();
      allow update: if isSuperOrGroup() && (isSuperAdmin() || resource.data.authorUid == request.auth.uid);
      allow delete: if isSuperOrGroup() && (isSuperAdmin() || resource.data.authorUid == request.auth.uid);
    }

    match /posts/{id} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() && uid() == resource.data.userUid;
      allow delete: if isSuperAdmin() || (isAuth() && uid() == resource.data.userUid);
    }

    match /comments/{id} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() && uid() == resource.data.userUid;
      allow delete: if isSuperAdmin() || (isAuth() && uid() == resource.data.userUid);
    }

    match /userStats/{userId} {
      allow read: if true;
      allow create, update: if isAuth() && uid() == userId;
      allow delete: if isSuperAdmin();
    }

    match /pushNotifications/{id} {
      allow read: if isSuperAdmin();
      allow create: if isSuperOrGroup();
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // Yarış performans verileri
    match /raceResults/{id} {
      allow read: if isAuth() && (
        resource.data.userId == uid() ||
        isSuperAdmin() ||
        isGroupAdmin()
      );
      allow create: if isAuth() && request.resource.data.userId == uid();
      allow update: if isAuth() && resource.data.userId == uid();
      allow delete: if isSuperAdmin() || (isAuth() && resource.data.userId == uid());
    }
  }
}
