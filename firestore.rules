rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function isSuperAdmin() {
      return isAuth() && request.auth.token.email == 'sedomem@gmail.com';
    }

    function isGroupAdmin() {
      return isAuth() && getUserData().role == 'groupadmin';
    }

    function isSuperOrGroup() { return isSuperAdmin() || isGroupAdmin(); }

    // Grup adminin kendi kulübü mü? (kulüp id = GA uid veya profildeki clubId)
    function isMyClub(clubId) {
      return isGroupAdmin() && (clubId == uid() || clubId == getUserData().get('clubId', ''));
    }

    // KVKK: kullanıcı profilleri (telefon, doğum tarihi, sağlık notları vb.) yalnızca
    // kişinin kendisi, süper admin ve grup adminleri tarafından okunabilir.
    // Üyeler kendi rollerini değiştiremez (yetki yükseltme engeli).
    match /users/{userId} {
      allow read: if (isAuth() && uid() == userId) || isSuperOrGroup();
      allow create: if isAuth() && uid() == userId
        && (!('role' in request.resource.data) || request.resource.data.role in ['member', 'pending_groupadmin']);
      allow update: if isSuperAdmin()
        || (isAuth() && uid() == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isSuperAdmin();
    }

    match /clubs/{id} {
      allow read: if true;
      allow create: if isSuperAdmin() || (isGroupAdmin() && id == uid());
      allow update: if isSuperAdmin() || (isAuth() && resource.data.adminUid == uid()
        && request.resource.data.adminUid == uid());
      allow delete: if isSuperAdmin();
    }

    match /events/{id} {
      allow read: if true;
      allow create: if isSuperOrGroup();
      allow update: if isSuperAdmin() || (isGroupAdmin() && (resource.data.adminUid == uid() || resource.data.clubId == getUserData().clubId));
      allow delete: if isSuperAdmin();

      match /attendees/{userId} {
        allow read: if isSuperOrGroup() || (isAuth() && uid() == userId);
        allow create, update: if isAuth() && (
          request.auth.token.email == 'sedomem@gmail.com' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'groupadmin'
        );
        allow delete: if isAuth() && request.auth.token.email == 'sedomem@gmail.com';
      }
    }

    // Üyeler yalnızca beğeni sayacını değiştirebilir
    match /races/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
      allow update: if isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
    }
    match /blog/{id} {
      allow read: if true;
      allow write: if isSuperAdmin();
      allow update: if isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']);
    }

    match /blog_comments/{id} {
      allow read: if true;
      allow create: if isAuth();
      // Yorum sahibi düzenler; diğer üyeler yalnızca beğeni sayısını değiştirebilir
      allow update: if isAuth() && (uid() == resource.data.authorUid || uid() == resource.data.userUid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']));
      allow delete: if isSuperAdmin() || (isAuth() && (uid() == resource.data.authorUid || uid() == resource.data.userUid));
    }

    match /popup/{id}    { allow read: if true; allow write: if isSuperAdmin(); }
    match /banners/{id}  { allow read: if true; allow write: if isSuperAdmin(); }
    match /sponsors/{id} { allow read: if true; allow write: if isSuperAdmin(); }
    match /firsatlar/{id}{ allow read: if true; allow write: if isSuperAdmin(); }
    match /ticker/{id}   { allow read: if true; allow write: if isSuperAdmin(); }

    // KVKK: katılım kayıtları e-posta içerir; yalnızca sahibi ve yöneticiler okur.
    // Kulüp yarışı katılımları (e-posta içermez) giriş yapmış üyelere açıktır.
    function ownsDoc(d) { return isAuth() && (d.get('uid', '') == uid() || d.get('userId', '') == uid()); }

    match /rsvps/{id} {
      allow read: if isSuperOrGroup() || ownsDoc(resource.data)
        || (isAuth() && resource.data.type == 'club_race');
      allow create: if ownsDoc(request.resource.data);
      allow update: if ownsDoc(resource.data) || isSuperOrGroup();
      allow delete: if ownsDoc(resource.data) || isSuperOrGroup();
    }

    // KVKK: üyelik kayıtları e-posta içerir; yalnızca sahibi ve yöneticiler okur.
    match /memberships/{id} {
      allow read: if isSuperOrGroup() || ownsDoc(resource.data);
      allow create: if isSuperAdmin() || ownsDoc(request.resource.data);
      allow update: if isSuperOrGroup();
      allow delete: if isSuperOrGroup() || ownsDoc(resource.data);
    }

    match /contactMessages/{id} {
      allow read: if isSuperAdmin();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    match /applications/{id} {
      allow read: if isSuperOrGroup();
      allow create: if true;
      allow update, delete: if isSuperAdmin();
    }

    // Yönetim sohbeti: yalnızca süper admin ve grup adminleri
    match /chats/{room}/{document=**} {
      allow read: if isSuperOrGroup();
      allow create: if isSuperOrGroup();
      allow update, delete: if isSuperAdmin();
    }

    match /newsletter/{id} {
      allow read: if isSuperAdmin();
      allow create: if true;
      allow delete: if isSuperAdmin();
    }

    match /announcements/{id} {
      allow read: if isAuth();
      allow create: if isSuperOrGroup();
      allow update: if isSuperOrGroup() && (isSuperAdmin() || resource.data.authorUid == request.auth.uid);
      allow delete: if isSuperOrGroup() && (isSuperAdmin() || resource.data.authorUid == request.auth.uid);
    }

    match /posts/{id} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() && (uid() == resource.data.userUid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes','commentCount']));
      allow delete: if isSuperAdmin() || (isAuth() && uid() == resource.data.userUid);
    }

    match /comments/{id} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isAuth() && (uid() == resource.data.userUid || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']));
      allow delete: if isSuperAdmin() || (isAuth() && uid() == resource.data.userUid);
    }

    match /userStats/{userId} {
      allow read: if true;
      allow create, update: if isAuth() && uid() == userId;
      allow delete: if isSuperAdmin();
    }

    match /pushNotifications/{id} {
      allow read: if isSuperAdmin();
      allow create: if isSuperOrGroup();
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    match /raceResults/{id} {
      allow read: if isAuth() && (
        resource.data.userId == uid() ||
        isSuperAdmin() ||
        isGroupAdmin()
      );
      allow create: if isAuth() && request.resource.data.userId == uid();
      allow update: if isAuth() && resource.data.userId == uid();
      allow delete: if isSuperAdmin() || (isAuth() && resource.data.userId == uid());
    }

    // Kulüp Etkinlik Takvimi
    match /club_events/{id} {
      allow read: if true;
      allow create: if isSuperAdmin() || isMyClub(request.resource.data.clubId);
      allow update: if isSuperAdmin() || (isMyClub(resource.data.clubId) && request.resource.data.clubId == resource.data.clubId);
      allow delete: if isSuperAdmin() || isMyClub(resource.data.clubId);
    }

    // Koşu / Antrenman Takvimi
    match /club_trainings/{id} {
      allow read: if true;
      allow create: if isSuperAdmin() || isMyClub(request.resource.data.clubId);
      allow update: if isSuperAdmin() || (isMyClub(resource.data.clubId) && request.resource.data.clubId == resource.data.clubId);
      allow delete: if isSuperAdmin() || isMyClub(resource.data.clubId);
    }

    // Kulüp Yarış Takvimi
    match /club_races/{id} { 
      allow read: if true; 
      allow write: if isSuperOrGroup(); 
    }

    // Topluluk Pazarı
    match /marketplace_items/{id} {
      allow read: if true;
      allow create: if isAuth();
      allow update: if isSuperAdmin() || (isAuth() && resource.data.userId == uid());
      allow delete: if isSuperAdmin() || (isAuth() && resource.data.userId == uid());
    }

    // Dahili Mesajlaşma
    match /conversations/{id} {
      allow read, update: if isAuth() && (uid() in resource.data.participants || isSuperAdmin());
      allow create: if isAuth();
      allow delete: if isSuperAdmin();
    }

    match /messages/{id} {
      allow read: if isSuperAdmin();
      allow create: if isAuth();
      allow update, delete: if isSuperAdmin();
    }

    // Yarış Tartışmaları (Faz 1)
    match /discussions/{id} {
      allow read: if true;
      allow create: if isAuth() && request.resource.data.userId == uid();
      allow update: if isSuperAdmin() || (isAuth() && (
        resource.data.userId == uid() ||
        // Sadece upvotes alanını güncellemeye izin ver (giriş yapmış herkes)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes'])
      ));
      allow delete: if isSuperAdmin() || (isAuth() && resource.data.userId == uid());
    }

    match /mail/{id} {
      allow create: if isSuperAdmin();
      allow read, update, delete: if false;
    }

  }
}
